GO_ENV=development
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Required by the DeepSeek-backed Cinna agent.
DEEPSEEK_API_KEY=your_deepseek_api_key

# Development-only AES-256 key. Generate a unique production key with:
# openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MESSAGE_ENCRYPTION_KEY_ID=local-v1

# Webhook variables are only required when GO_ENV=production.
WEBHOOK_URL=https://your-public-host.example
WEBHOOK_SECRET=your_webhook_secret

# PostgreSQL
POSTGRES_USER=cinna
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cinna

DATABASE_URL=postgres://cinna:change_me@localhost:5432/cinna?sslmode=disable
