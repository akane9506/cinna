{
  "name": "cinna",
  "version": "1.0.0",
  "description": "Telegram daily assistant",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --hot src/index.ts",
    "test": "bun test:isolate",
    "test:isolate": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.{ts,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,json,md}'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akane9506/cinna.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/akane9506/cinna/issues"
  },
  "homepage": "https://github.com/akane9506/cinna#readme",
  "dependencies": {
    "@google/genai": "^2.2.0",
    "firebase-admin": "^13.10.0",
    "hono": "^4.12.18",
    "pino": "^10.3.1",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
